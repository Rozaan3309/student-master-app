<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="student_report" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10"/>
    <style name="Zebra" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#EAF5F4"/>
        </conditionalStyle>
    </style>

    <parameter name="ID_FROM" class="java.lang.Integer"/>
    <parameter name="ID_TO" class="java.lang.Integer"/>
    <parameter name="LOGO" class="java.io.InputStream"/>
    <parameter name="GENERATED_ON" class="java.lang.String"/>

    <queryString>
        <![CDATA[SELECT student_id, name, email
                 FROM students
                 WHERE student_id BETWEEN $P{ID_FROM} AND $P{ID_TO}
                 ORDER BY student_id]]>
    </queryString>

    <field name="student_id" class="java.lang.Integer"/>
    <field name="name" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>

    <variable name="TotalStudents" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{student_id}]]></variableExpression>
    </variable>

    <pageHeader>
        <band height="82">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="72" backcolor="#0B3C49"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="72" width="515" height="3" backcolor="#F59E0B"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="10" y="8" width="56" height="56"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="78" y="12" width="270" height="28" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[STUDENT MASTER]]></text>
            </staticText>
            <staticText>
                <reportElement x="78" y="40" width="270" height="18" forecolor="#8FE3D8"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Student Data Report]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="16" width="205" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Student ID  " + $P{ID_FROM} + "  -  " + $P{ID_TO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="40" width="205" height="18" forecolor="#BFE9E4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated " + $P{GENERATED_ON}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="26">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="40" height="26" forecolor="#FFFFFF" backcolor="#0F766E"/>
                <box leftPadding="6"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="40" y="0" width="85" height="26" forecolor="#FFFFFF" backcolor="#0F766E"/>
                <box leftPadding="6"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Student ID]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="125" y="0" width="170" height="26" forecolor="#FFFFFF" backcolor="#0F766E"/>
                <box leftPadding="6"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="295" y="0" width="220" height="26" forecolor="#FFFFFF" backcolor="#0F766E"/>
                <box leftPadding="6"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Email]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField>
                <reportElement style="Zebra" x="0" y="0" width="40" height="22"/>
                <box leftPadding="6"><bottomPen lineWidth="0.5" lineColor="#CFE3E1"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Zebra" x="40" y="0" width="85" height="22"/>
                <box leftPadding="6"><bottomPen lineWidth="0.5" lineColor="#CFE3E1"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{student_id}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement style="Zebra" x="125" y="0" width="170" height="22"/>
                <box leftPadding="6"><bottomPen lineWidth="0.5" lineColor="#CFE3E1"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement style="Zebra" x="295" y="0" width="220" height="22"/>
                <box leftPadding="6"><bottomPen lineWidth="0.5" lineColor="#CFE3E1"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="2" width="515" height="1" forecolor="#0F766E"/>
            </line>
            <staticText>
                <reportElement x="0" y="8" width="300" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <text><![CDATA[Student Master  |  Student Data Report]]></text>
            </staticText>
            <textField>
                <reportElement x="395" y="8" width="80" height="16" forecolor="#0B3C49"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="475" y="8" width="40" height="16" forecolor="#0B3C49"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="40">
            <textField>
                <reportElement x="0" y="10" width="515" height="20" forecolor="#0B3C49"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total students in this report: " + $V{TotalStudents}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
